SELECT `t`.`Id`, `t`.`CreationTime`, `t`.`DeletionTime`, `t`.`IsDeleted`, `t`.`LastModificationTime`, `t`.`TagName`, `t0`.`ArticleId`, `t0`.`TagId`, `t0`.`Id`, `t0`.`Content`, `t0`.`CreationTime`, `t0`.`DeletionTime`, `t0`.`Desc`, `t0`.`Image`, `t0`.`IsDeleted`, `t0`.`LastModificationTime`, `t0`.`Likes`, `t0`.`Title`, `t0`.`UserId`, `t0`.`Views`
