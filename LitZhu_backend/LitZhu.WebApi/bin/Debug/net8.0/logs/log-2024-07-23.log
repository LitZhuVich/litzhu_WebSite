FROM `Tags` AS `t`
LEFT JOIN (
    SELECT `a`.`ArticleId`, `a`.`TagId`, `t1`.`Id`, `t1`.`Content`, `t1`.`CreationTime`, `t1`.`DeletionTime`, `t1`.`Desc`, `t1`.`Image`, `t1`.`IsDeleted`, `t1`.`LastModificationTime`, `t1`.`Likes`, `t1`.`Title`, `t1`.`UserId`, `t1`.`Views`
    FROM `Articles_Tags` AS `a`
    INNER JOIN (
        SELECT `a0`.`Id`, `a0`.`Content`, `a0`.`CreationTime`, `a0`.`DeletionTime`, `a0`.`Desc`, `a0`.`Image`, `a0`.`IsDeleted`, `a0`.`LastModificationTime`, `a0`.`Likes`, `a0`.`Title`, `a0`.`UserId`, `a0`.`Views`
